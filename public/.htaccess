<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

    RewriteEngine On

    ##
    ## You may need to uncomment (remove #) the following line for some hosting environments,
    ## if you have installed to a subdirectory, enter the name here also.
    ## Example: for https://site.com enter: "/", for https://site.com/something enter: "/something/"
    ##
    # RewriteBase /

    # Strip trailing encoded spaces (%20) from URLs
    RewriteCond %{THE_REQUEST} ^[A-Z]+ (.+?)%20+ HTTP
    RewriteRule ^ %1 [R=301,L]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [L,R=301]

    # Handle Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule mod_headers.c>
    <Files "ngsw-worker.js">
        Header Set Service-Worker-allowed "/"
    </Files>

    # Allow the bundled native app (origin capacitor://localhost) to cross-origin
    # fetch STATIC front-end assets served directly by the web server (which
    # bypasses Laravel, so config/cors.php can't add the header). Most important:
    # the SVG icon sprite (/assets/icons/merged.svg) — without CORS the WKWebView
    # blocks it and every mat-icon (navbar buttons, share/rate icons) is blank.
    # Scoped to static file extensions so API routes keep Laravel's own CORS
    # header (avoids a duplicate Access-Control-Allow-Origin). Public files, so a
    # wildcard origin is safe.
    <FilesMatch "\.(svg|png|jpe?g|gif|webp|ico|woff2?|ttf|eot|js|css|json|map|mp4|webm|vtt)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>
