# Copy to .env and fill in real values. NEVER commit the real .env —
# it is gitignored (/.env). This example documents the keys only.

APP_NAME="Her Vision Network"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com
INSTALLED=true

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Mail (notifications: account blocked/unblocked emails)
MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Her Vision Network"

# Google sign-in (Socialite) — create at console.cloud.google.com
GOOGLE_ID=
GOOGLE_SECRET=

# TMDB (title metadata import)
TMDB_API_KEY=

# Cloudflare R2 — creator video direct upload (browser → R2, bypasses PHP).
# Bucket: create in Cloudflare R2; enable the Public Development URL; add a
# CORS policy allowing PUT/GET from your site origin. Create an R2 API token
# (Object Read & Write) for the key/secret. Endpoint is
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com (no bucket suffix).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=
